# ============================================================
# ZYVORA configuration — copy to .env and fill in real values.
# NEVER commit your real .env to git.
# ============================================================

# ---- Core ----
ZYVORA_NAME=ZYVORA
ZYVORA_DEBUG=1
ZYVORA_HOST=0.0.0.0
ZYVORA_PORT=8000
# Public https URL of this server (used for the Telegram WebApp button).
# For local development: http://localhost:8000 (WebApp button needs https in real Telegram).
ZYVORA_PUBLIC_URL=https://your-domain.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZYVORA_SECRET_KEY=
ZYVORA_SESSION_DAYS=14
# Extra allowed CORS origins (comma separated), optional
ZYVORA_ALLOWED_ORIGINS=

# ---- MySQL (primary database) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zyvora
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=zyvora
# Full URL override (optional, wins over MYSQL_*):
# DATABASE_URL=mysql+pymysql://zyvora:change-me@127.0.0.1:3306/zyvora?charset=utf8mb4
# 1 = refuse to fall back to SQLite (recommended for production)
ZYVORA_REQUIRE_MYSQL=0
# 1 = allow automatic SQLite fallback when MySQL is unreachable (dev convenience)
ZYVORA_ALLOW_SQLITE_FALLBACK=1

# ---- Telegram bot ----
# Get from @BotFather
BOT_TOKEN=
BOT_USERNAME=my_zyvora_bot
# Telegram IDs that become admins automatically (comma separated)
ZYVORA_ADMIN_IDS=

# ---- Initial website admin (created on first start) ----
ZYVORA_ADMIN_EMAIL=admin@example.com
# If empty, a random password is generated and printed to the log once
ZYVORA_ADMIN_PASSWORD=

# ---- AI providers (all optional; the app works without them and says so) ----
OPENAI_API_KEY=
STABILITY_API_KEY=
MESHY_API_KEY=
RUNWAY_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Email (optional) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=1

# ---- Limits ----
ZYVORA_WELCOME_CREDITS=50
ZYVORA_UPLOAD_MAX_MB=5
ZYVORA_PROJECT_MAX_KB=4096
ZYVORA_GEN_DAILY_LIMIT=30
ZYVORA_GEN_MAX_CONCURRENT=2

# ---- DEV ONLY: allow opening /app WebApp in a plain browser without Telegram ----
# Never enable in production. Adds a shared dev account (telegram_id=900000001, admin).
ZYVORA_DEV_WEBAPP_BYPASS=0
