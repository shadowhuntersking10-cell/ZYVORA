# ===== ZYVORA environment (copy to .env and fill in) =====
# Never commit .env. Never put these values in the frontend.

ENVIRONMENT=development            # development | production
APP_NAME=ZYVORA

# --- Database (PostgreSQL in Docker; sqlite is for quick local dev only)
DATABASE_URL=postgresql+psycopg://zyvora:zyvora@db:5432/zyvora
# DATABASE_URL=sqlite:///./zyvora-dev.db

# --- Auth. JWT_SECRET is REQUIRED in production (min 32 random characters).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false                # true when served over HTTPS
COOKIE_SAMESITE=lax                # lax (same-site app). Use none + COOKIE_SECURE=true only for a cross-site iframe preview
REQUIRE_EMAIL_VERIFICATION=false   # true once SMTP is connected
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_PER_MINUTE=20

# --- First administrator (seed script creates ONLY this account)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password-1
ADMIN_NAME=Administrator

# --- AI providers. Empty key => the provider is reported as "provider not connected".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MESHY_API_KEY=
TRIPO_API_KEY=
STABILITY_API_KEY=
VIDEO_PROVIDER_API_KEY=            # no video endpoint implemented yet
AUDIO_PROVIDER_API_KEY=            # no audio endpoint implemented yet

# --- Storage / queue / payments (not yet wired into the app; reported honestly in admin)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=zyvora
REDIS_URL=redis://redis:6379/0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Limits
MAX_UPLOAD_MB=50
MAX_DOCUMENT_KB=2048
MAX_VERSIONS_KEPT=50

# --- Frontend dev server only: where Vite proxies /api
ZYVORA_API_URL=http://localhost:8000
